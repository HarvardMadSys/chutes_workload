       p->p_last_request = in_cache_lru_queue.re_request(p->p_last_request);
+#ifdef UPDATE_OBJ_SIZE_ON_HIT
+      /* LLM KV-cache replay: a returning conversation carries a longer
+       * context; grow the resident object and evict on overflow so LRB pays
+       * for context growth like every other policy (upstream LRB only sets
+       * _size at admission, silently inflating its effective capacity) */
+      uint64_t new_size = static_cast<uint64_t>(req.size);

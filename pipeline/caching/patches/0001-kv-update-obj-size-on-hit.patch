diff --git a/libCacheSim/cache/eviction/ARC.c b/libCacheSim/cache/eviction/ARC.c
index c8b22d8..e2c3384 100644
--- a/libCacheSim/cache/eviction/ARC.c
+++ b/libCacheSim/cache/eviction/ARC.c
@@ -220,12 +220,34 @@ static cache_obj_t *ARC_find(cache_t *cache, const request_t *req,
                              bool update_cache) {
   ARC_params_t *params = (ARC_params_t *)(cache->eviction_params);
 
+#ifdef UPDATE_OBJ_SIZE_ON_HIT
+  cache_obj_t *pre = hashtable_find_obj_id(cache->hashtable, req->obj_id);
+  int64_t old_size = pre != NULL ? (int64_t)pre->obj_size : -1;
+#endif
+
   cache_obj_t *obj = cache_find_base(cache, req, update_cache);
 
   if (obj == NULL) {
     return NULL;
   }
 
+#ifdef UPDATE_OBJ_SIZE_ON_HIT
+  /* cache_find_base resized the object; keep ARC's byte accounting
+   * consistent: ghosts are not resident so the resize is undone, resident
+   * objects propagate the delta into their data-list byte counter */
+  if (update_cache && old_size >= 0 && old_size != (int64_t)obj->obj_size) {
+    int64_t delta = (int64_t)obj->obj_size - old_size;
+    if (obj->ARC.ghost) {
+      cache->occupied_byte -= delta;
+      obj->obj_size = (uint32_t)old_size;
+    } else if (obj->ARC.lru_id == 1) {
+      params->L1_data_size += delta;
+    } else {
+      params->L2_data_size += delta;
+    }
+  }
+#endif
+
   if (!update_cache) {
     return obj->ARC.ghost ? NULL : obj;
   }
@@ -574,6 +596,17 @@ static void _ARC_evict_miss_on_all_queues(cache_t *cache,
       _ARC_replace(cache, req);
       return;
     } else {
+#ifdef UPDATE_OBJ_SIZE_ON_HIT
+      /* the on-hit eviction loop can reach here with an oversized request
+       * (grown object larger than the cache) while L1 data is empty;
+       * evict from L2 data instead of dereferencing a NULL L1 tail */
+      if (params->L1_data_tail == NULL) {
+        if (params->L2_data_tail != NULL) {
+          _ARC_evict_L2_data(cache, req);
+        }
+        return;
+      }
+#endif
       // T1 >= c, L1 data size is too large, ghost is empty, so evict from L1
       // data
       _ARC_evict_L1_data_no_ghost(cache, req);
